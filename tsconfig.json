{
  "type": "module",
  "compilerOptions": {
    "target": "ES6",
    "module": "NodeNext",
    "rootDir": "./server/src",
    "outDir": "./server/dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./server/src",
    "paths": {
      "*": ["*"]
    }
  },
  "include": ["bcrypt.d.ts", "server/src/server.ts", "server/src/app.ts", "server/src/routes.ts"],
  "exclude": ["node_modules"]
}