<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <link rel="icon" type="image/x-icon" href="/images/favicon.ico">

        <title>404 Not Found</title>
        <script src="https://cdn.tailwindcss.com"></script>
    </head>
    <body class="bg-slate-900 text-white flex items-center justify-center h-screen">
        <div class="container text-center border-white border-2 p-8 rounded-lg">
            <h1 class="error-code text-9xl font-bold">404</h1>
            <p class="text-3xl">Something went wrong</p>
            <p class="font-bold text-2xl text-red-600 text-left font-mono mt-12"><%= message %></p>
            <div class="sketch w-72 h-72 bg-contain bg-center bg-no-repeat" style="background-image: url('https://example.com/sketch.png');"></div>
        </div>
    </body>
</html>